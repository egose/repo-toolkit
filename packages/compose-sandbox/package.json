{
  "name": "@repo-toolkit/compose-sandbox",
  "description": "Run a repository-defined Docker Compose test sandbox through a deterministic lifecycle",
  "version": "0.0.0-PLACEHOLDER",
  "license": "PLACEHOLDER",
  "repository": "PLACEHOLDER",
  "type": "module",
  "sideEffects": false,
  "keywords": [
    "docker",
    "compose",
    "sandbox",
    "integration",
    "tooling"
  ],
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "repo-toolkit-compose-sandbox": "dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup --config tsup.config.ts",
    "test": "pnpm --filter @repo-toolkit/compose-sandbox... build && vitest run --config vitest.config.ts",
    "compose-sandbox": "node dist/cli.js"
  },
  "dependencies": {
    "@repo-toolkit/publish-package": "workspace:*"
  },
  "files": [
    "README.md",
    "dist"
  ],
  "engines": {
    "node": ">=20"
  }
}
