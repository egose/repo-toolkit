{
  "name": "repo-toolkit",
  "version": "0.16.0",
  "private": true,
  "description": "Shared monorepo for repository tooling packages",
  "license": "Apache-2.0",
  "author": "Junmin Ahn",
  "packageManager": "pnpm@10.14.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/egose/repo-toolkit.git"
  },
  "bugs": {
    "url": "https://github.com/egose/repo-toolkit/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "lint": "eslint .",
    "lint-fix": "eslint --fix .",
    "typecheck": "pnpm -r exec tsc --noEmit",
    "build": "pnpm -r --if-present build",
    "changelog": "pnpm --filter @repo-toolkit/changelog... build && node packages/changelog/dist/cli.js",
    "publish-package": "pnpm --filter @repo-toolkit/publish-package... build && node packages/publish-package/dist/cli.js",
    "publish-packages": "pnpm --filter @repo-toolkit/publish-packages... build && node packages/publish-packages/dist/cli.js",
    "build-artifact": "pnpm --filter @repo-toolkit/release-artifact... build && node packages/release-artifact/dist/cli-build.js",
    "verify-artifact": "pnpm --filter @repo-toolkit/release-artifact... build && node packages/release-artifact/dist/cli-verify.js",
    "install-artifact": "pnpm --filter @repo-toolkit/release-artifact... build && node packages/release-artifact/dist/cli-install.js",
    "gen-install": "pnpm --filter @repo-toolkit/release-artifact gen-install",
    "confluence": "pnpm --filter @repo-toolkit/confluence... build && node packages/confluence/dist/cli.js",
    "compose-sandbox": "pnpm --filter @repo-toolkit/compose-sandbox... build && node packages/compose-sandbox/dist/cli.js",
    "build-go-release": "pnpm --filter @repo-toolkit/go-release... build && node packages/go-release/dist/cli-build.js",
    "verify-go-release": "pnpm --filter @repo-toolkit/go-release... build && node packages/go-release/dist/cli-verify.js",
    "release": "release-it",
    "test": "pnpm -r --workspace-concurrency=1 --if-present test"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@commitlint/format": "^21.2.2",
    "@eslint/js": "^10.0.1",
    "@release-it/bumper": "^8.0.0",
    "@types/node": "^26.2.0",
    "eslint": "10.8.1",
    "globals": "^17.11.0",
    "prettier": "4.0.0-alpha.13",
    "release-it": "^21.0.2",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.10"
  }
}
